{
    // ADD a from-source build method to base configsys's `opencv`. Bindings merge additively, so
    // this sits ALONGSIDE the core `via: native` (CPU) binding — native stays the default; the
    // source build is opt-in with `configsys pin set opencv opencv-build`.
    //
    // CPU-only by default: the CPU binding below requires nothing beyond the recipe's build deps
    // (cmake + a C++ compiler, pulled by `requires:`). To build with GPU acceleration, replace it
    // with a `gpu:` variant AND name the matching SDK in `requires:` on the SAME binding — the
    // driver maps the tokens to CMake flags and refuses to build if the toolchain is missing (never
    // a silent CPU fallback). Because the SDK is a `requires:` on the GPU binding only, a CPU build
    // never drags in something heavy like CUDA. `gpu: [ cuda ]` auto-clones opencv_contrib (the CUDA
    // modules — cudaarithm, cudaimgproc, ... — live there). Token table + knobs are in README.md.
    components: {
        opencv: {
            install: [
                { via: opencv-build  ref: 4.11.0  dir: opencv-git  requires: [ cmake, cpp-toolchain, git ] }

                // GPU examples — replace the CPU binding above with one of these. GPU tokens compose:
                //   cuda  = WITH_CUDA (core/imgproc/cuda* accel); needs only cuda-toolkit.
                //   cudnn = the DNN CUDA backend; needs cuDNN AND implies cuda -> add the `cudnn`
                //           dependency component too. `nvidia` is shorthand for [ cuda, cudnn ].
                // `gcc-10` in requires: is the CUDA HOST compiler — nvcc for CUDA 11.4–11.6 chokes on
                // gcc 11+'s std_function.h, so configsys installs gcc-10 and the driver points nvcc
                // at it. On CUDA 12.x you can drop it (or require the gcc your CUDA supports); or set
                // `cuda-host-compiler: /usr/bin/gcc-N` to override the driver's auto-pick.
                // { via: opencv-build  ref: 4.11.0  dir: opencv-git  gpu: [ cuda ]
                //   requires: [ cmake, cpp-toolchain, git, cuda-toolkit, gcc-10 ] }               // CUDA, no DNN backend (no cuDNN needed)
                // { via: opencv-build  ref: 4.11.0  dir: opencv-git  gpu: [ nvidia ]
                //   requires: [ cmake, cpp-toolchain, git, cuda-toolkit, cudnn, gcc-10 ] }         // the works: CUDA + cuDNN DNN backend
                // { via: opencv-build  ref: 4.11.0  dir: opencv-git  gpu: [ hip ]
                //   requires: [ cmake, cpp-toolchain, git, rocm-hip ] }                            // AMD (experimental in OpenCV)
                // add `contrib: true` to a CPU binding to also clone opencv_contrib's extra modules
            ]
        }

        // cuda-repo — set up NVIDIA's CUDA network repo (the apt/dnf source that carries cuDNN and
        // NVIDIA's own CUDA packages). NOT needed on Arch (cuda/cudnn ship in the official repos), so
        // it's a `requires:` on cuDNN's debian/redhat binding only. `via: script` because the repo
        // URL is distro-codename-specific (ubuntu2204 / debian12 / rhel9 / …) — the command derives
        // it from /etc/os-release (UBUNTU_CODENAME covers ubuntu derivatives: pop/mint/elementary/…).
        // Debian family installs the `cuda-keyring` .deb (adds key + source list); RHEL family adds
        // the .repo via dnf config-manager.
        cuda-repo: {
            description: "NVIDIA CUDA network repo (apt/dnf) — the source cuDNN & CUDA packages come from."
            install: [
                { via: script  when: "debian"
                  install-cmd:   'set -e; . /etc/os-release; if [ -n "${UBUNTU_CODENAME:-}" ]; then case "$UBUNTU_CODENAME" in focal) SEG=ubuntu2004;; jammy) SEG=ubuntu2204;; noble) SEG=ubuntu2404;; *) SEG=ubuntu2204;; esac; elif [ "$ID" = debian ]; then SEG="debian${VERSION_ID%%.*}"; else SEG="${ID}$(echo "$VERSION_ID" | tr -d .)"; fi; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; T="$(mktemp -d)"; curl -fSL "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-keyring_1.1-1_all.deb" -o "$T/k.deb"; sudo dpkg -i "$T/k.deb"; sudo apt-get update; rm -rf "$T"'
                  version-cmd:   'dpkg-query -W -f=${Version} cuda-keyring 2>/dev/null'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-keyring'
                  location:      '/etc/apt/sources.list.d/cuda-*.list (+ cuda-keyring)' }
                { via: script  when: "redhat"
                  install-cmd:   'set -e; . /etc/os-release; case "$ID" in fedora) SEG="fedora$VERSION_ID";; *) SEG="rhel${VERSION_ID%%.*}";; esac; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; sudo dnf config-manager --add-repo "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-$SEG.repo"; sudo dnf -q clean expire-cache'
                  version-cmd:   'ls /etc/yum.repos.d/cuda-*.repo >/dev/null 2>&1 && echo present'
                  version-re:    '(present)'
                  uninstall-cmd: 'sudo rm -f /etc/yum.repos.d/cuda-*.repo'
                  location:      '/etc/yum.repos.d/cuda-*.repo' }
            ]
        }

        // cuDNN — NVIDIA's deep-neural-network primitives. OpenCV's DNN CUDA backend
        // (OPENCV_DNN_CUDA / the `cudnn` gpu token) hard-requires it. In Arch's official repos
        // (pacman cudnn — no NVIDIA repo needed). On debian/redhat it's NOT in the distro repos
        // (NVIDIA license), so the binding pulls `cuda-repo` (adds NVIDIA's source) then installs
        // `libcudnn8-dev` — the cuDNN-8 dev package (headers + runtime), covering CUDA 11 / early 12;
        // for a cuDNN-9 / CUDA-12.3+ box swap the name to `libcudnn9-dev-cuda-12`.
        // debian/redhat use `via: script` (not plain native) for ONE reason: NVIDIA's libcudnn8
        // packages skip the ldconfig trigger, so the runtime .so lands but isn't in the loader cache
        // — the freshly-built OpenCV then can't load libcudnn.so.8 at runtime. The script installs
        // the dev package (headers + runtime) AND runs ldconfig. Arch's pacman handles ldconfig, so
        // it stays plain native. `requires: cuda-repo` on the deb/rpm bindings adds NVIDIA's source.
        cudnn: {
            description: "NVIDIA cuDNN — DNN primitives; OpenCV's DNN CUDA backend needs it."
            requires: cuda-toolkit
            install: [
                { via: native  when: "arch"  name: cudnn }                         // Arch ships it (pacman runs ldconfig); no NVIDIA repo
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn8-dev && sudo ldconfig'
                  version-cmd:   'dpkg-query -W -f=${Version} libcudnn8-dev 2>/dev/null'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn8-dev && sudo ldconfig'
                  location:      'libcudnn8-dev (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn8-devel && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn8-devel 2>/dev/null'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn8-devel && sudo ldconfig'
                  location:      'libcudnn8-devel (dnf) + ldconfig cache' }
            ]
        }
    }
}
